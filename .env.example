# ALFRED local development configuration. Do not store secrets here.
ALFRED_ENV=development
ALFRED_OLLAMA_BASE_URL=http://localhost:11434
ALFRED_OLLAMA_MODEL=qwen3:8b
ALFRED_OLLAMA_FALLBACK_MODEL=qwen3:4b
ALFRED_OLLAMA_TIMEOUT_MS=5000
ALFRED_OLLAMA_RESPONSE_TIMEOUT_MS=60000
# Optional path to a JSON file containing name, identity, traits, and communicationStyle overrides.
ALFRED_PERSONALITY_FILE=
ALFRED_RESPONSE_LENGTH=balanced
# Optional instructions appended after ALFRED's application-owned capabilities and constraints.
ALFRED_EXTRA_INSTRUCTIONS=
ALFRED_LOG_LEVEL=info
ALFRED_DATABASE_PATH=./data/alfred.sqlite
ALFRED_VOICE_STT_PROVIDER=none
ALFRED_VOICE_TTS_PROVIDER=none
