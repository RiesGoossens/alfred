{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@alfred/core": ["packages/core/src/index.ts"],
      "@alfred/providers": ["packages/providers/src/index.ts"],
      "@alfred/tools": ["packages/tools/src/index.ts"],
      "@alfred/voice": ["packages/voice/src/index.ts"]
    }
  }
}
